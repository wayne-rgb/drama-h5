{
  "name": "hongguotv",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "start": "node server/index.mjs",
    "server": "node server/index.mjs",
    "dev": "npm --prefix apps/web-pc run dev",
    "build": "npm --prefix apps/web-pc run build",
    "typecheck": "npm --prefix apps/web-pc exec -- tsc --noEmit -p apps/web-pc/tsconfig.json",
    "desktop:dev": "npm --prefix apps/web-pc run desktop:dev",
    "build:desktop": "npm run build && node scripts/build-bundles.mjs --platforms=win-x64",
    "test": "node --test tests/*.test.mjs",
    "probe": "node scripts/probe.mjs",
    "sync-server": "node apps/sync-server/index.mjs",
    "build:bundles": "node scripts/build-bundles.mjs"
  },
  "dependencies": {
    "axios": "1.20.0",
    "google-auth-library": "11.3.0",
    "nodemailer": "10.1.0",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "GPL-3.0-only"
}
