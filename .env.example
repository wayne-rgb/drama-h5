# 服务自动读取项目根目录.env，已有进程环境变量优先；可用HG_ENV_FILE指定其他文件。
# Docker Compose 2.24及以上同样在运行时读取.env，容器的监听地址与数据目录由compose.yaml固定。
HG_HOST=127.0.0.1
PORT=8788
# HG_MANAGED仅用于本机桌面或本机服务，H5部署不要开启；桌面主进程自行生成访问证明。
# 仅填写直接连接服务的可信代理IP；留空时不信任X-Forwarded-For。
TRUSTED_PROXY_IPS=
# 上传总空间含在途文件预留与处理副本，默认100GiB，不自动删除已就绪素材。
CONTENT_MAX_STORAGE_BYTES=107374182400
# 个人资料单独核算；达到上限暂停写入，已有收藏与历史保持可读，不自动删除用户记录。
PERSONAL_MAX_GUESTS=10000
PERSONAL_GUEST_TOTAL_BYTES=2147483648
PERSONAL_GUEST_PROFILE_BYTES=33554432
PERSONAL_TOTAL_BYTES=10737418240
PERSONAL_MIN_FREE_BYTES=536870912
# 实际H5播放并发保护与单次流请求时限，按机器容量调整。
CONTENT_MAX_ACTIVE_STREAMS=64
CONTENT_MAX_VIEWER_STREAMS=6
CONTENT_MAX_IP_STREAMS=24
CONTENT_STREAM_TIMEOUT_MS=1800000
# 公开接口及播放请求的每分钟持续额度，允许同额度的短时突发；IP额度兼顾共享网络。
# 静态构建文件也按独立计数遵守IP及全站请求额度，不与正常接口轮询互相挤占。
API_VIEWER_REQUESTS_PER_MINUTE=360
API_IP_REQUESTS_PER_MINUTE=1800
API_GLOBAL_REQUESTS_PER_MINUTE=6000
CONTENT_VIEWER_REQUESTS_PER_MINUTE=120
CONTENT_IP_REQUESTS_PER_MINUTE=600
CONTENT_GLOBAL_REQUESTS_PER_MINUTE=1200
API_MAX_ACTIVE_REQUESTS=128
CONTENT_MAX_UPSTREAM_REQUESTS=32
HTTP_MAX_CONNECTIONS=512
# 视频响应按字节计费保护，独立数据库持久化；按UTC自然日恢复，正常关闭退还未用预留。
# 默认全站100GiB、单观众5GiB、单IP50GiB；按实际运营规模调整，达到上限会停止播放传输。
CONTENT_DAILY_BYTES=107374182400
# 全站总额度中的20GiB只给有效VIP与管理员；总额度仍为100GiB，不增加总费用上限。
CONTENT_VIP_RESERVED_BYTES=21474836480
CONTENT_VIEWER_DAILY_BYTES=5368709120
CONTENT_IP_DAILY_BYTES=53687091200
# Docker Compose binds to loopback by default; change HG_BIND_IP for LAN access.
HG_BIND_IP=127.0.0.1
HG_PORT=8788
# Optional local data directory; never commit its database or configuration.
# HG_DATA_DIR=/path/to/local-data

# 正式站点地址；Vite开发时改为http://127.0.0.1:4318，线上使用实际HTTPS域名。
APP_ORIGIN=http://127.0.0.1:8788
# Google控制台的回调地址需为APP_ORIGIN加/api/auth/google/callback。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 邮箱验证与密码找回；未配置时不会伪造发送成功。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 支付服务尚未确定，默认关闭；选择Stripe后再改为stripe并配置下列密钥。
BILLING_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe通知地址为APP_ORIGIN加/api/billing/webhook。
# 启用前需在Stripe后台开启客户门户，供用户管理支付方式和取消续费。
# 内容后台位于/admin。先注册账户，再将/api/account/session返回的user.id加入管理员列表。
# 使用不可自行指定的账户编号，避免他人抢先注册同名邮箱取得后台权限。
ADMIN_ACCOUNT_IDS=
# 先由管理员在后台“账户安全”绑定验证器，再设为1要求所有管理员完成二次验证。
# 保留0以兼容现有账号；已绑定的账号无论此开关如何都必须验证才能进入后台。
ADMIN_REQUIRE_MFA=0
# 可选的64位十六进制加密密钥。留空会在数据目录生成权限为0600的.mfa-key，需与数据库一起备份。
ACCOUNT_MFA_KEY=
# 已接入邮件验证时，也可指定经过验证的管理员邮箱，多个用英文逗号分隔。
ADMIN_EMAILS=
# 上传视频上限默认2GB；封面上限8MB。媒体只通过受权限保护的接口读取。
CONTENT_MAX_VIDEO_BYTES=2147483648
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Linux媒体解析子进程的内存地址空间与CPU时间硬限制；镜像自带prlimit。
CONTENT_MEDIA_MEMORY_BYTES=536870912
CONTENT_MEDIA_CPU_SECONDS=180
PRLIMIT_PATH=prlimit
# 监听checkout.session.completed、customer.subscription.created/updated/deleted、invoice.paid、invoice.payment_failed。
